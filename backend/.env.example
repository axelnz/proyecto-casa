# Configuración del Servidor
PORT=3000

# Seguridad: CORS
# Orígenes permitidos (para desarrollo local suele ser localhost)
CORS_ORIGIN=http://localhost:5173,https://proyecto-casa-three.vercel.app

# Base de Datos (Supabase PostgreSQL o Local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Seguridad: JWT
JWT_SECRET=una_clave_secreta_and_larga_para_produccion

# Activación opcional de Supabase (solo en el backend, NUNCA en variables VITE_)
SUPABASE_PROJECT_REF=
SUPABASE_MANAGEMENT_TOKEN=
# Código independiente para la familia, al menos 12 caracteres aleatorios.
SYSTEM_WAKE_CODE=

# Configurar según los proxies del hosting. Ver docs/SYSTEM_WAKE.md.
TRUST_PROXY=
